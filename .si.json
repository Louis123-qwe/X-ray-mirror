{
  "plugin": "org.smartide.plugin.framework.javascript.vite",
  "run": "npm install && npm run dev -- --host",
  "intelligence": {
    ".json": {
      "enabled": true,
      "run": "vscode-json-language-server --stdio"
    },
    ".js": {
      "enabled": true,
      "run": "typescript-language-server --stdio"
    },
    ".html": {
      "enabled": false,
      "run": "vscode-html-language-server --stdio"
    },
    ".sh": {
      "enabled": true,
      "run": "bash-language-server start"
    }
  }
}